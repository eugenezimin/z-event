        <mxCell id="title" value="&lt;b&gt;Scenario 0 · Real-time delivery&lt;/b&gt; — one &lt;i&gt;orders&lt;/i&gt; instance, one &lt;i&gt;billing&lt;/i&gt; instance, billing is caught up" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1690" height="34" as="geometry" /></mxCell>
        <mxCell id="pre" value="&lt;b&gt;Steady state, nothing outstanding.&lt;/b&gt; billing&#x27;s cursor is 175 and orders&#x27; head is 175. billing&#x27;s Subscribe stream has been open since billing started and is idle, with a heartbeat Checkpoint every 15 s. Nobody polls." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="230" y="62" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="user" value="User or&lt;br&gt;API client" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="168" width="36" height="64" as="geometry" /></mxCell>
        <mxCell id="orders" value="orders service · producer · 1 instance" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="230" y="120" width="670" height="290" as="geometry" /></mxCell>
