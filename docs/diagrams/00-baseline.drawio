        <mxCell id="acl" value="&lt;b&gt;Acl&lt;/b&gt; (TypeAcl)&lt;br&gt;&lt;i&gt;checked once, when the stream opened&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="orders"><mxGeometry x="260" y="50" width="190" height="60" as="geometry" /></mxCell>
