  <diagram id="scenario-00-realtime" name="00 Real-time 1:1">
    <mxGraphModel dx="1780" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1010" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
